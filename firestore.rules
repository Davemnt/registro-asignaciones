rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Todo lo de la app vive dentro de "datos":
    //   datos/horarios, datos/fechas, datos/relevos-sostenimientos,
    //   datos/himnos-publico (lo que lee la página del QR),
    //   datos/registro/items/{asignación}  (una por documento, en tiempo real)
    //   datos/registro/respaldos/{copia}   (respaldos automáticos)
    // La app inicia sesión de forma anónima, así que se exige una sesión activa.
    match /datos/{documento=**} {
      allow read, write: if request.auth != null;
    }
  }
}
